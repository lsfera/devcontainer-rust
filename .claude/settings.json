{
  "permissions": {
    "allow": [
      "Bash(cargo test *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "thedotmack-claude-mem": {
      "source": "github",
      "repo": "thedotmack/claude-mem"
    }
  },
  "enabledPlugins": {
    "plugin@thedotmack-claude-mem": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
